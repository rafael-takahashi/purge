{
  "manifest_version": 3,
  "name": "Purge",
  "version": "1.0.0",
  "icons": {
    "32": "purge-logo.svg",
    "64": "purge-logo.svg"
  },
  "description": "Remove DOM elements persistently from webpages via Shift+Click.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["storage.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@purge",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
